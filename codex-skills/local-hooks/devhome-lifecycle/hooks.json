{
  "description": "Windows-native DevHome safety guardrails and Remember compatibility hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event PreToolUse",
            "commandWindows": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event PreToolUse",
            "timeout": 5,
            "statusMessage": "Checking DevHome safety policy"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\DevHome\\state\\codex\\hooks\\Invoke-RememberAdapter.cmd --event SessionStart",
            "commandWindows": "D:\\DevHome\\state\\codex\\hooks\\Invoke-RememberAdapter.cmd --event SessionStart",
            "timeout": 20,
            "statusMessage": "Loading Remember context through Codex adapter"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event UserPromptSubmit",
            "commandWindows": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Checking prompt for exposed secrets"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\DevHome\\state\\codex\\hooks\\Invoke-RememberAdapter.cmd --event PostToolUse",
            "commandWindows": "D:\\DevHome\\state\\codex\\hooks\\Invoke-RememberAdapter.cmd --event PostToolUse",
            "async": true,
            "timeout": 5,
            "statusMessage": "Capturing Codex session for Remember"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\DevHome\\state\\codex\\hooks\\Invoke-RememberAdapter.cmd --event Stop",
            "commandWindows": "D:\\DevHome\\state\\codex\\hooks\\Invoke-RememberAdapter.cmd --event Stop",
            "timeout": 5,
            "statusMessage": "Finalizing Remember transcript capture"
          }
        ]
      }
    ]
  }
}
