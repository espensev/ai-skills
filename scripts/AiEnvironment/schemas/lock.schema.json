{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-skills:ai-environment-lock:v1",
  "title": "AI environment accepted-artifact lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profileId", "state", "capturedAtUtc", "source", "providers", "resources", "acceptance"],
  "properties": {
    "schema": { "const": "ai-skills/ai-environment-lock/v1" },
    "profileId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "state": { "enum": ["candidate", "accepted", "retired"] },
    "capturedAtUtc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "requireCleanWorktree"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "requireCleanWorktree": { "type": "boolean" }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": { "$ref": "#/$defs/providerLock" },
        "claude": { "$ref": "#/$defs/providerLock" }
      }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourceLock" }
    },
    "acceptance": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceLock" }
    }
  },
  "$defs": {
    "providerLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testedVersions"],
      "properties": {
        "testedVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" }
        }
      }
    },
    "resourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "payload"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "trustHash": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
        "payload": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
            }
          }
        }
      }
    },
    "acceptanceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "checkedAtUtc", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "checkedAtUtc": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
