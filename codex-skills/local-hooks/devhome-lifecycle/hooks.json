{
  "description": "Windows-native DevHome safety guardrails and the Codex Handoff Relay.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event PreToolUse",
            "commandWindows": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event PreToolUse",
            "timeout": 5,
            "statusMessage": "Checking DevHome safety policy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event UserPromptSubmit",
            "commandWindows": "pwsh -NoProfile -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-DevHomeHook.ps1\" -Event UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Checking prompt for exposed secrets"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-HandoffRelay.ps1\" -Provider Codex",
            "commandWindows": "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"D:\\DevHome\\state\\codex\\hooks\\Invoke-HandoffRelay.ps1\" -Provider Codex",
            "timeout": 5,
            "statusMessage": "Handoff Relay: preparing next-session context"
          }
        ]
      }
    ]
  }
}
